/*
 * Aurora Lily58 - Børge's dev keymap
 *
 * OS keyboard layout on every host: Norwegian (Bokmål).
 * Symbols are emitted through the NB_ key codes from zmk-locales, so the
 * firmware sends the Norwegian scancode (incl. AltGr combos) for each symbol.
 *
 * Layers: 0 BASE  1 NAV  2 SYM  3 FN  4 MAC  5 MAC_NAV (NAV + MAC, automatic)
 *
 * Cross-OS rule: inner left thumb + Tab switches apps everywhere
 * (Alt+Tab on Windows/Linux, Cmd+Tab on macOS). The MAC layer turns on with
 * Bluetooth profile 1 (FN+1) and off with profiles 2-5.
 *
 * Visual map: docs/keymap.html
 * The Keebio Iris rev7 (QMK) in qmk/ shares all layers except the thumb row.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <locale/keys_nb.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define FN   3
#define MAC  4
#define MAC_NAV 5

/ {
    behaviors {
        tog_on: tog_on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "on";
        };
        tog_off: tog_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        mac_nav {
            if-layers = <NAV MAC>;
            then-layer = <MAC_NAV>;
        };
    };

    macros {
        /* Dead keys on the Norwegian layout: send the key, then a space, so the plain symbol comes out. */
        no_tilde: no_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp NB_TILDE>, <&kp SPACE>;
        };
        no_caret: no_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp NB_CARET>, <&kp SPACE>;
        };
        no_grave: no_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp NB_GRAVE>, <&kp SPACE>;
        };

        /* Host switch: select the Bluetooth profile, set the underglow to that host's colour,
         * and turn the MAC layer on (profile 1 = Mac) or off (2-5). */
        bt0: bt0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&rgb_ug RGB_COLOR_HSB(0,100,20)>, <&tog_on MAC>;     /* red, Mac */
        };
        bt1: bt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&rgb_ug RGB_COLOR_HSB(120,100,20)>, <&tog_off MAC>;   /* green */
        };
        bt2: bt2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&rgb_ug RGB_COLOR_HSB(240,100,20)>, <&tog_off MAC>;   /* blue */
        };
        bt3: bt3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&rgb_ug RGB_COLOR_HSB(60,100,20)>, <&tog_off MAC>;   /* yellow */
        };
        bt4: bt4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&rgb_ug RGB_COLOR_HSB(280,100,20)>, <&tog_off MAC>;   /* purple */
        };
    };

    combos {
        compatible = "zmk,combos";
        /* Both shifts together: Caps Word, for ENV_VARS and CONSTANTS. */
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <24 35>;
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BSPC  |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |  DEL  |
// | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   | SHIFT |
// | CTRL  |  Z  |  X  |  C   |  V   |  B   |   =    |  |   -   |  N   |  M    |  ,    |  .   |   /   |   '   |
//                     | GUI  | ALT  | NAV  |  SPACE |  | ENTER | SYM  | BSPC  |  FN   |
            bindings = <
&kp ESC   &kp NB_N1 &kp NB_N2 &kp NB_N3 &kp NB_N4 &kp NB_N5                               &kp NB_N6 &kp NB_N7 &kp NB_N8    &kp NB_N9  &kp NB_N0   &kp BSPC
&kp TAB   &kp NB_Q  &kp NB_W  &kp NB_E  &kp NB_R  &kp NB_T                                &kp NB_Y  &kp NB_U  &kp NB_I     &kp NB_O   &kp NB_P    &kp DEL
&kp LSHFT &kp NB_A  &kp NB_S  &kp NB_D  &kp NB_F  &kp NB_G                                &kp NB_H  &kp NB_J  &kp NB_K     &kp NB_L   &kp NB_SEMI &kp RSHFT
&kp LCTRL &kp NB_Z  &kp NB_X  &kp NB_C  &kp NB_V  &kp NB_B  &kp NB_EQUAL     &kp NB_MINUS &kp NB_N  &kp NB_M  &kp NB_COMMA &kp NB_DOT &kp NB_FSLH &kp NB_SQT
                              &kp LGUI  &kp LALT  &mo NAV   &kp SPACE        &kp RET      &mo SYM   &kp BSPC  &mo FN
            >;
        };

        nav_layer {
            display-name = "NAV";
// ------------------------------------------------------------------------------------------------------------
// | PRTSC |     |     |      |      |      |                   |      |       |       |      |       |       |
// |  WIN  | INS |DELW<|DELW> | HOME | END  |                   | PLAY | VOL+  | VOL-  | MUTE | BRI+  | BRI-  |
// |       |     |  <- |  ->  |  ^   | PGUP |                   |      | ZOOM+ | ZOOM- | ZOOM0|       |       |
// |       | DEL |WORD<|WORD> |  v   | PGDN |        |  |       |      |       |       |      |       |       |
//                     |      |      | HELD |        |  |       |      |       |       |
// Arrows on the left hand so the right hand can stay on the mouse. Shift/Ctrl on the left pinky column pass through.
// DELW< / DELW> = delete word left / right (Ctrl+Backspace, Ctrl+Del). WORD< / WORD> = jump a word (Ctrl+arrow).
// WIN = next window of the same app (Alt+` on Linux/GNOME, Cmd+< on macOS via MAC_NAV)
            bindings = <
&kp PSCRN       &trans   &trans       &trans        &trans    &trans                       &trans   &trans           &trans            &trans         &trans       &trans
&kp LA(NB_PIPE) &kp INS  &kp LC(BSPC) &kp LC(DEL)   &kp HOME  &kp END                      &kp C_PP &kp C_VOL_UP     &kp C_VOL_DN      &kp C_MUTE     &kp C_BRI_UP &kp C_BRI_DN
&trans          &trans   &kp LEFT     &kp RIGHT     &kp UP    &kp PG_UP                    &trans   &kp LC(NB_PLUS)  &kp LC(NB_MINUS)  &kp LC(NB_N0)  &trans       &trans
&trans          &kp DEL  &kp LC(LEFT) &kp LC(RIGHT) &kp DOWN  &kp PG_DN &trans    &trans   &trans   &trans           &trans            &trans         &trans       &trans
                                      &trans        &trans    &trans    &trans    &trans   &trans   &trans           &trans
            >;
        };

        sym_layer {
            display-name = "SYM";
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |  <  |  >  |  ~   |  $   |  %   |                   |  "   |   !   |   ?   |  ^   |   Å   |       |
// |       |  (  |  )  |  {   |  }   |  |   |                   |  `   |   +   |   =   |  -   |   Ø   |       |
// |       |  [  |  ]  |  \   |  &   |  *   |        |  |       |  €   |   @   |   #   |  _   |   Æ   |       |
//                     |      |      |      |        |  |       | HELD |       |       |
// Bracket pairs on resting finger pairs: < > above ( ) on Q W / A S, { } on D F, [ ] on Z X.
// Right home row: ` + = - from the inner reach outward, _ under the -. " ! ? ^ on Y U I O, € @ # on N M and the , key.
// Å Ø Æ in one column under 0 (P ; /). Outer right column free.
            bindings = <
&trans &trans      &trans      &trans      &trans      &trans                           &trans     &trans      &trans       &trans       &trans         &trans
&trans &kp NB_LT   &kp NB_GT   &no_tilde   &kp NB_DLLR &kp NB_PRCNT                     &kp NB_DQT  &kp NB_EXCL &kp NB_QMARK &no_caret    &kp NB_A_RING  &trans
&trans &kp NB_LPAR &kp NB_RPAR &kp NB_LBRC &kp NB_RBRC &kp NB_PIPE                      &no_grave   &kp NB_PLUS &kp NB_EQUAL &kp NB_MINUS &kp NB_O_SLASH &trans
&trans &kp NB_LBKT &kp NB_RBKT &kp NB_BSLH &kp NB_AMPS &kp NB_ASTRK &trans     &trans   &kp NB_EURO &kp NB_AT   &kp NB_HASH  &kp NB_UNDER &kp NB_AE      &trans
                               &trans      &trans      &trans       &trans     &trans   &trans     &trans      &trans
            >;
        };

        fn_layer {
            display-name = "FN";
// ------------------------------------------------------------------------------------------------------------
// |       | BT1 | BT2 | BT3  | BT4  | BT5  |                   |BTCLR |USB/BT | LED   | LED- | LED+  |  MAC  |
// |       | F1  | F2  | F3   | F4   | F5   |                   |  /   |   7   |   8   |  9   |   -   | BSPC  |
// |       | F6  | F7  | F8   | F9   | F10  |                   |  *   |   4   |   5   |  6   |   +   | ENTER |
// |       | F11 | F12 |  ´   |  ¨   |      |        |  |       |  0   |   1   |   2   |  3   |   .   |   =   |
//                     |      |      |      |        |  |       |      |       |       | HELD |
// BT1 is the Mac: it also turns the MAC layer on; BT2-5 turn it off. MAC toggles it by hand.
// Numpad sends plain digits, not keypad codes, so it works regardless of NumLock on Windows/Linux.
// ´ and ¨ are the Norwegian dead keys for accents: ´ then e = é, ¨ then u = ü.
            bindings = <
&trans &bt0    &bt1    &bt2         &bt3          &bt4                         &bt BT_CLR   &out OUT_TOG &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI &tog MAC
&trans &kp F1  &kp F2  &kp F3       &kp F4        &kp F5                       &kp NB_FSLH  &kp NB_N7    &kp NB_N8       &kp NB_N9       &kp NB_MINUS    &kp BSPC
&trans &kp F6  &kp F7  &kp F8       &kp F9        &kp F10                      &kp NB_ASTRK &kp NB_N4    &kp NB_N5       &kp NB_N6       &kp NB_PLUS     &kp RET
&trans &kp F11 &kp F12 &kp NB_ACUTE &kp NB_UMLAUT &trans  &trans      &trans   &kp NB_N0    &kp NB_N1    &kp NB_N2       &kp NB_N3       &kp NB_DOT      &kp NB_EQUAL
                       &trans       &trans        &trans  &trans      &trans   &trans       &trans       &trans
            >;
        };

        mac_layer {
            display-name = "MAC";
            /*
             * On with Bluetooth profile 1 (or FN + MAC by hand). The thumbs keep
             * their order: the outer GUI key is Cmd on macOS, the ALT key is Opt,
             * the pinky stays Ctrl. This layer is a flag: with NAV held it enables
             * MAC_NAV, which swaps the OS-specific NAV keys to Cmd/Opt combos.
             * TODO: the Norwegian macOS layout uses different Option combos for
             * @ $ { } [ ] | \ than Windows/Linux; add a mac SYM layer when needed.
             */
            bindings = <
&trans &trans &trans &trans &trans &trans                        &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                        &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                        &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans       &trans    &trans &trans &trans &trans &trans &trans
                     &trans &trans &trans &trans       &trans    &trans &trans &trans
            >;
        };

        mac_nav_layer {
            display-name = "MACNAV";
            /* NAV while MAC is on: Cmd/Opt versions of the OS-specific NAV keys, same positions as NAV. */
            bindings = <
&trans        &trans &trans       &trans        &trans &trans                       &trans &trans          &trans           &trans        &trans &trans
&kp LG(NB_LT) &trans &kp LA(BSPC) &kp LA(DEL)   &trans &trans                       &trans &trans          &trans           &trans        &trans &trans
&trans        &trans &trans       &trans        &trans &trans                       &trans &kp LG(NB_PLUS) &kp LG(NB_MINUS) &kp LG(NB_N0) &trans &trans
&trans        &trans &kp LA(LEFT) &kp LA(RIGHT) &trans &trans &trans      &trans    &trans &trans          &trans           &trans        &trans &trans
                                  &trans        &trans &trans &trans      &trans    &trans &trans          &trans
            >;
        };
    };
};
